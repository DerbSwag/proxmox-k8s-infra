$TTL    604800
@       IN      SOA     dns-server.lab.local. admin.lab.local. (
                              2024040302         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
; Name servers
@       IN      NS      dns-server.lab.local.

; A records
dns-server      IN      A       192.0.2.143
k8s-master      IN      A       192.0.2.140
k8s-worker-01   IN      A       192.0.2.141
k8s-worker-02   IN      A       192.0.2.142
hypervisor-01           IN      A       192.0.2.95
hypervisor-02           IN      A       192.0.2.96

; Services
grafana         IN      A       192.0.2.140
prometheus      IN      A       192.0.2.140
zabbix          IN      A       192.0.2.140
argocd          IN      A       192.0.2.140
